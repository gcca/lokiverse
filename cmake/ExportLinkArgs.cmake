cmake_minimum_required(VERSION 4.3)

set(command "")
set(started FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(i RANGE ${last})
  if(started)
    list(APPEND command "${CMAKE_ARGV${i}}")
  elseif(CMAKE_ARGV${i} STREQUAL "--")
    set(started TRUE)
  endif()
endforeach()
if(NOT command)
  message(FATAL_ERROR "lokiverse: no link command to record")
endif()

execute_process(COMMAND ${command} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "lokiverse: link command failed")
endif()

set(arguments "")
set(pending "")
foreach(piece IN LISTS command)
  if(pending STREQUAL "skip")
    set(pending "")
  elseif(pending)
    list(APPEND arguments "${pending}" "${piece}")
    set(pending "")
  elseif(piece STREQUAL "-o")
    set(pending "skip")
  elseif(piece STREQUAL "-framework")
    set(pending "${piece}")
  elseif(piece MATCHES "^(-l|-L|-F|-Wl,-rpath,|-Wl,-framework,|-pthread$)")
    list(APPEND arguments "${piece}")
  elseif(piece MATCHES "\\.(a|dylib|tbd|so(\\.[0-9]+)*)$")
    get_filename_component(piece "${piece}" ABSOLUTE)
    list(APPEND arguments "${piece}")
  endif()
endforeach()
string(REPLACE "," ";" runtime "${RUNTIME}")
foreach(library IN LISTS runtime)
  if(library MATCHES "^(c\\+\\+|c\\+\\+abi|stdc\\+\\+|m)$")
    list(APPEND arguments "-l${library}")
  endif()
endforeach()

list(JOIN arguments "\n" content)
set(content "${content}\n")
set(previous "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
