macro(lokiverse_find_static_absl)
  if(NOT TARGET absl::strings)
    set(lokiverse_absl_static_dir "")
    foreach(lokiverse_prefix IN LISTS CMAKE_PREFIX_PATH CMAKE_SYSTEM_PREFIX_PATH)
      foreach(lokiverse_libdir IN ITEMS lib lib64)
        set(lokiverse_candidate "${lokiverse_prefix}/${lokiverse_libdir}/cmake/absl-static")
        if(NOT lokiverse_absl_static_dir AND EXISTS "${lokiverse_candidate}/abslConfig.cmake")
          set(lokiverse_absl_static_dir "${lokiverse_candidate}")
        endif()
      endforeach()
    endforeach()
    if(NOT lokiverse_absl_static_dir)
      message(FATAL_ERROR "lokiverse: static Abseil package (lib/cmake/absl-static) not found")
    endif()
    find_package(absl CONFIG REQUIRED NO_DEFAULT_PATH PATHS "${lokiverse_absl_static_dir}")
  endif()
endmacro()

function(lokiverse_use_static_archives)
  foreach(target IN LISTS ARGN)
    if(NOT TARGET ${target})
      continue()
    endif()
    get_target_property(configs ${target} IMPORTED_CONFIGURATIONS)
    set(properties IMPORTED_LOCATION)
    if(configs)
      foreach(config IN LISTS configs)
        list(APPEND properties "IMPORTED_LOCATION_${config}")
      endforeach()
    endif()
    foreach(property IN LISTS properties)
      get_target_property(location ${target} ${property})
      if(location MATCHES "^(.*)\\.(so(\\.[0-9]+)*|dylib)$")
        set(archive "${CMAKE_MATCH_1}.a")
        string(REGEX REPLACE "(\\.[0-9]+)+\\.a$" ".a" archive "${archive}")
        if(NOT EXISTS "${archive}")
          message(FATAL_ERROR "lokiverse: static archive ${archive} for ${target} not found")
        endif()
        set_property(TARGET ${target} PROPERTY ${property} "${archive}")
      endif()
    endforeach()
  endforeach()
endfunction()
